Parameter[CharacteristicName %in% c("Phosphate-phosphorus","Phosphate-phosphorus***retired***use Total Phosphorus, mixed forms","Total Phosphorus, mixed forms") & ResultSampleFractionText=="Dissolved"]="Dissolved phosphorus"
})
