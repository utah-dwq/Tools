library(tidyverse)
library(leaflet)
library(readxl)
library(geojsonsf)
library(leaflet.extras)
library(leaflet.extras2)
library(htmltools)
coordinator_shp<-geojson_sf(file.choose())
basin_shp<-geojson_sf(file.choose())
mytext<-paste(
"Watershed Coordinator: ", coordinator_shp$Watershed_, "<br/>",
"Email: ", coordinator_shp$Email, "<br/>",
"Phone: ",coordinator_shp$Phone, "<br/>",
"Basin: ",coordinator_shp$MGMT_UNIT, "<br/>",
"AUID: ",coordinator_shp$MAPLABEL, "<br/>",
"Beneficial Uses: ", coordinator_shp$BEN_CLASS, "<br/>",
sep = "") %>%
lapply(htmltools::HTML)
pop_up<-paste(coordinator_shp$MGMT_UNIT)
map_title <- tags$div(tag.map.title <- tags$style(HTML(".leaflet-control.map-title {
background: rgba(255,255,255,0.9);
padding: 10px;
font-weight: bold;
font-size: 18px;
border-radius: 5px;}")),
HTML("Basin Coordinator Locator Map"))
map_info <- tags$div(tag.map.info <- tags$style(HTML(".leaflet-control.map-info {
padding: 0px;
font-weight: normal;
font-size: 8px;
border-radius: 0px;}")),
HTML("Use search bar (lat/long or city name) to find general area then",
"<br/>",
"select location on map to view basin coordinator contact info"))
rain_map <-leaflet() %>%
addProviderTiles("Esri.WorldTopoMap", options = providerTileOptions(updateWhenZooming = FALSE,updateWhenIdle = TRUE)) %>%
addGeosearch(
provider = geosearchProvider("Esri"),
options = geosearchOptions(
position = "topleft",
searchLabel = "Search for places...",
keepResult = TRUE,
autoComplete = TRUE,)) %>%
addPolygons(data=basin_shp,
color = "black",
fillOpacity = 0,
weight = 1,
opacity = 0.4,
stroke = TRUE,
labelOptions = labelOptions
(style = list("font-weight" = "normal",
padding = "3px 8px"), textsize = "10px",
direction = "auto")) %>%
addPolygons(data=coordinator_shp,
color = "black",
fillOpacity = 0.02,
weight = 0.1,
opacity = 0.5,
label = pop_up,
stroke = TRUE,
popup = mytext,
labelOptions = labelOptions
(style = list("font-weight" = "normal",
padding = "3px 8px"), textsize = "10px",
direction = "auto")) %>%
addControl(html = map_title,
position = "topright",
className = "map-title") %>%
addControl(html= map_info,
position = "topright",
className = "map-info")
#View
rain_map
