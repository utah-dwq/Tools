wb_poly=subset(wqTools::au_poly, ASSESS_ID=="UT-L-16030001-006_00")
poly_bbox=sf::st_bbox(wb_poly)
baseMap() %>%
clearGroup("Assessment units") %>%
addPolygons(data=wb_poly,group="Assessment units",fillOpacity = 0.1,weight=3,color="orange", options = pathOptions(pane = "au_poly")) %>%
showGroup("Assessment units") %>%
addCircleMarkers(data=sites, lng=~LongitudeMeasure, lat=~LatitudeMeasure, label=~MonitoringLocationIdentifier, options = pathOptions(pane = "markers"), labelOptions = labelOptions(noHide = T)) %>%
fitBounds(poly_bbox[[1]], poly_bbox[[2]], poly_bbox[[3]], poly_bbox[[4]])
View(wb_poly)
