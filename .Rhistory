hline <- function(y = 0, color = "blue", dash="dash") {
list(
type = "line",
x0 = 0,
x1 = 1,
xref = "paper",
y0 = y,
y1 = y,
line = list(color = color, dash=dash)
)
}
plot_ly(x=~ActivityStartDate, y=~ResultMeasureValue) %>%
add_markers(data=subset(wq_data_DO_P, Parameter=="Dissolved oxygen (DO)" & type=="lake"), type="scatter", name=~MonitoringLocationIdentifier,
marker = list(size = 8)) %>%
layout(
shapes = list(hline(4, color="black")),
title="",
yaxis = list(side = 'left', title = 'Dissolved oxygen (mg/L)'),
xaxis = list(title = '')
) %>%
config(displaylogo = FALSE,
modeBarButtonsToRemove = c(
'sendDataToCloud',
'hoverClosestCartesian',
'hoverCompareCartesian',
'lasso2d',
'select2d'
)
)
pct_exc=subset(wq_data_DO_P, Parameter=="Dissolved oxygen (DO)" & type=="lake" & !is.na(DataLoggerLine)) %>%
mutate(exc=ifelse(ResultMeasureValue<4,1,0), count=1) %>%
group_by(MonitoringLocationIdentifier, ActivityStartDate) %>%
summarize(pct_exc=sum(exc)/sum(count)*100, .groups="drop")
plot_ly(x=~ActivityStartDate, y=~pct_exc) %>%
add_markers(data=pct_exc, type="scatter", name=~MonitoringLocationIdentifier,
marker = list(size = 8)) %>%
layout(
yaxis = list(side = 'left', title = 'Dissolved oxygen % < 4 mg/L'),
xaxis = list(title = '')
) %>%
config(displaylogo = FALSE,
modeBarButtonsToRemove = c(
'sendDataToCloud',
'hoverClosestCartesian',
'hoverCompareCartesian',
'lasso2d',
'select2d'
)
)
plot_ly(x=~ActivityStartDate, y=~ResultMeasureValue) %>%
add_markers(data=subset(wq_data_DO_P, Parameter=="Total phosphorus" & type=="lake" & ResultMeasureValue<=1.5), type="scatter", name=~MonitoringLocationIdentifier,
marker = list(size = 8)) %>%
layout(
shapes = list(hline(0.025, color="black")),
title="",
yaxis = list(side = 'left', title = 'Total phosphorus (mg/L)'),
updatemenus = list(list(
active = 0,
y=0.75,
x=1.2,
buttons= list(
list(label = 'linear',
method = 'update',
args = list(list(visible = T), list(yaxis = list(title = 'Total phosphorus (mg/L)', type = 'linear')))
),
list(label = 'log',
method = 'update',
args = list(list(visible = T), list(yaxis = list(title = 'Total phosphorus (mg/L)', type = 'log')))
)
)
)),
xaxis = list(title = '')
) %>%
config(displaylogo = FALSE,
modeBarButtonsToRemove = c(
'sendDataToCloud',
'hoverClosestCartesian',
'hoverCompareCartesian',
'lasso2d',
'select2d'
)
)
